# ══════════════════════════════════════════════════════════════════════════════
#  MapLayer — Environment Variables
#  Copy this file to .env and fill in your values before starting the app.
#
#    cp .env.example .env
#
#  For Docker Compose (local): use the "Local Docker" values shown below.
#  For Railway + Vercel (production): use the "Production" values shown below.
# ══════════════════════════════════════════════════════════════════════════════


# ─── AI — Required ────────────────────────────────────────────────────────────

# Google Gemini API key — used for AI column mapping and metric discovery.
# Get one free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here


# ─── PostgreSQL ───────────────────────────────────────────────────────────────

POSTGRES_USER=maplayer
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=maplayer_db

# Local Docker Compose → use the service name as host
POSTGRES_HOST=postgres
# Production (Railway) → e.g. postgres.railway.internal
# POSTGRES_HOST=your-postgres-host.railway.internal

POSTGRES_PORT=5432


# ─── Redis (Celery broker) ────────────────────────────────────────────────────

# Local Docker Compose
REDIS_URL=redis://redis:6379/0
# Production (Railway Redis plugin)
# REDIS_URL=redis://default:password@your-redis-host.railway.internal:6379/0


# ─── Qdrant (vector search) ───────────────────────────────────────────────────

# Local Docker Compose → use the service name as host
QDRANT_HOST=qdrant
# Production (Railway or Qdrant Cloud)
# QDRANT_HOST=your-qdrant-host.railway.internal

QDRANT_PORT=6333


# ─── CORS (production only) ───────────────────────────────────────────────────

# Set this after your first Vercel deploy so the backend allows your frontend.
# Leave blank for local development — localhost:3000 is always allowed.
# FRONTEND_URL=https://your-app.vercel.app


# ─── Frontend ─────────────────────────────────────────────────────────────────
#
# This variable is read by Next.js (prefix NEXT_PUBLIC_ makes it available
# in the browser). Set it in one of two ways:
#
#   Local development  →  create frontend/.env.local with:
#                           NEXT_PUBLIC_API_URL=http://localhost:8000
#
#   Vercel deployment  →  add it in the Vercel project dashboard:
#                           NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
#
# It is listed here for reference only — Next.js does not read the root .env.
NEXT_PUBLIC_API_URL=http://localhost:8000
