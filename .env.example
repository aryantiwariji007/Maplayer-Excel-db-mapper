# API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (PostgreSQL)
POSTGRES_USER=maplayer
POSTGRES_PASSWORD=maplayer_password
POSTGRES_DB=maplayer_db
