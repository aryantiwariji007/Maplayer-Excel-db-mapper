# Redis (for Celery background workers)
REDIS_URL=redis://localhost:6379/0

# Qdrant (Vector Database)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# (Frontend) API Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
